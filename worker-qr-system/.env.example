# Application Configuration
APP_NAME="Worker QR Verification Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/worker-qr-system/public
APP_TIMEZONE=UTC
APP_KEY=base64:7vF8sP2mK1wQ4zX9eR0lT5jN3yB6vC8xM1pA4dG7hJ2=

# Database Connection (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
